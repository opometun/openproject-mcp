# OpenProject API credentials (required)
OPENPROJECT_BASE_URL=https://your-openproject.example.com
OPENPROJECT_API_KEY=your_api_key_here

# HTTP server (commonly overridden)
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
FASTMCP_STREAMABLE_HTTP_PATH=/mcp

# Runtime environment and CORS
MCP_ENV=dev               # dev | local | prod
MCP_ALLOWED_ORIGINS=      # comma-separated origins, e.g. https://app.example.com
MCP_DEV_ALLOW_LOCALHOST=false
MCP_ALLOW_CREDENTIALS=false

# Security headers / proxy
MCP_CSP_ENABLED=false
MCP_HSTS_ENABLED=false
MCP_TRUST_PROXY_HEADERS=false
MCP_TRUSTED_PROXIES=      # comma-separated CIDRs, required if TRUST_PROXY_HEADERS=true

# Timeouts & body limits
MCP_REQUEST_TIMEOUT_S=30
MCP_MAX_BODY_BYTES=1000000
MCP_TIMEOUT_STATUS=504    # one of 408, 503, 504

# Rate limiting
MCP_RATE_LIMIT_RPM=60
MCP_RATE_LIMIT_WINDOW_S=60
MCP_RATE_LIMIT_MAX_KEYS=10000
MCP_RATE_LIMIT_TTL_WINDOWS=3
MCP_RATE_LIMIT_SSE_RPM=10
MCP_RATE_LIMIT_ALLOW_DISABLE=false
MCP_ALLOW_DISABLE_LIMITS=false   # only respected in dev/local
MCP_RATE_LIMIT_HASH_SECRET=      # optional secret for hashing keys

# Streaming / SSE
MCP_ENABLE_SSE=false
MCP_SSE_KEEPALIVE_S=15

# Response mode
FASTMCP_JSON_RESPONSE=true
FASTMCP_STATELESS_HTTP=true
